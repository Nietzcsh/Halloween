rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/uids/$(request.auth.uid));
    }
    function myKey() {
      return get(/databases/$(database)/documents/uids/$(request.auth.uid)).data.memberKey;
    }
    function canRead() {
      return isAdmin() || isMember();
    }
    function validMember(key) {
      return key.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && key.size() <= 40
        && request.resource.data.key == key
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
    }

    match /adminSecrets/{pin} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'at'])
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[A-Za-z0-9_-]{4,64}$')
        && exists(/databases/$(database)/documents/adminSecrets/$(request.resource.data.pin));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /members/{key} {
      allow read: if signedIn();
      allow create: if (
          signedIn() && validMember(key)
          && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/uids/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/uids/$(request.auth.uid)).data.memberKey == key
        ) || (
          isAdmin() && validMember(key) && request.resource.data.uid == null
        );
      allow update: if isAdmin() || (
          signedIn()
          && resource.data.uid == null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'claimedAt'])
          && !exists(/databases/$(database)/documents/uids/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/uids/$(request.auth.uid)).data.memberKey == key
        );
      allow delete: if isAdmin();
    }

    match /uids/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['memberKey', 'at'])
        && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberKey)).data.uid == uid;
      allow delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /photos/{id} {
      allow read: if canRead();
      allow create: if (isAdmin() || (isMember() && request.resource.data.uploaderUid == request.auth.uid))
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin() || (signedIn() && resource.data.uploaderUid == request.auth.uid);
    }

    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && request.resource.data.path is string
        && request.resource.data.path.matches('^/[A-Za-z0-9/_-]*$')
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120;
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if canRead();
      allow create: if request.resource.data.keys().hasOnly(['text', 'memberKey', 'name', 'fromAdmin', 'uid', 'photo', 'pinned', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.pinned == false
        && (
          (isMember() && request.resource.data.fromAdmin == false && request.resource.data.memberKey == myKey())
          || (isAdmin() && request.resource.data.fromAdmin == true && request.resource.data.memberKey == null)
        );
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /receipts/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.memberKey == myKey());
      allow write: if isAdmin();
    }

    match /polls/{pollId} {
      allow read: if canRead();
      allow write: if isAdmin();

      match /responses/{memberKey} {
        allow get: if isAdmin() || (isMember() && myKey() == memberKey);
        allow list: if isAdmin();
        allow create, update: if isMember()
          && myKey() == memberKey
          && get(/databases/$(database)/documents/polls/$(pollId)).data.open == true
          && request.resource.data.keys().hasOnly(['answer', 'memberKey', 'at'])
          && request.resource.data.memberKey == memberKey
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 500;
        allow delete: if isAdmin();
      }
    }
  }
}
